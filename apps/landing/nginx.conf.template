# thunderforge.dev: the homepage at /, the browser demo at /demo/, and a
# cached read-only window onto the repository's GitHub stars.
#
# A template: the nginx image substitutes ${GITHUB_TOKEN} at start. GitHub only
# lists stargazers to an authenticated caller, so the token stays here and no
# browser ever sees it. Without one the star chart shows contributors only.

upstream github_api {
  server api.github.com:443;
  keepalive 4;
}

# Every visitor is served from this cache. GitHub is asked again at most once
# every ten minutes per path and pod, and an error or rate limit from GitHub
# serves the last good answer instead (kept for a week).
proxy_cache_path /var/cache/nginx/github levels=1:2 keys_zone=github:1m max_size=20m inactive=7d use_temp_path=off;

map "${GITHUB_TOKEN}" $github_auth {
  ""      "";
  default "Bearer ${GITHUB_TOKEN}";
}

# Spec 086: browser telemetry for the landing and the demo
# (specs/086-full-telemetry/contracts/served-config-and-csp.md). The image
# defines ${TELEMETRY} and the two THUNDERFORGE_BROWSER_TELEMETRY_* values;
# `TELEMETRY=false` turns both pages' reporting off, and the pages then load
# nothing for it.

# 1. Is it on?
map "${TELEMETRY}" $telemetry_on {
  default               1;
  ~*^(false|0|no|off)$  0;
}

# 2. The tier, by the same normalisation as the server's tier_for.
map "${THUNDERFORGE_BROWSER_TELEMETRY_ENDPOINT}" $telemetry_tier {
  default                                            operator;
  ~*^https://telemetry\.thunderforge\.dev(:443)?/?$  anonymous;
  ~^[^:]*$                                           anonymous;
}

# 3. The endpoint's origin, for connect-src.
map "${THUNDERFORGE_BROWSER_TELEMETRY_ENDPOINT}" $telemetry_origin_raw {
  ~^(?<o>https?://[^/]+)  $o;
  default                 "";
}
map $telemetry_on $telemetry_origin {
  1       $telemetry_origin_raw;
  default "";
}

# 4. The served config.
map $telemetry_on $telemetry_json {
  1       '{"enabled":true,"endpoint":"${THUNDERFORGE_BROWSER_TELEMETRY_ENDPOINT}","sampleRate":${THUNDERFORGE_BROWSER_TELEMETRY_SAMPLE_RATE},"environment":"production","tier":"$telemetry_tier"}';
  default '{"enabled":false}';
}

# 5. The demo's connect-src: its own files, and the endpoint when on.
map $telemetry_origin $telemetry_connect {
  ""      "connect-src 'self' data: blob:";
  default "connect-src 'self' data: blob: $telemetry_origin";
}

# Spec 086 FR-027: the access log is JSON and holds no visitor. No address,
# no X-Forwarded-For, no user agent, no query string, and the referrer only
# as its origin. The path is the one asked for, before try_files rewrote it.
map $request_uri $request_path {
  ~^(?<rp>[^?#]*)  $rp;
  default          "";
}
map $http_referer $referrer_origin {
  ~^(?<ro>https?://[^/?#]+)  $ro;
  default                    "";
}

log_format landing_json escape=json
  '{"time":"$time_iso8601","method":"$request_method","path":"$request_path",'
  '"status":$status,"bytes":$body_bytes_sent,"request_time":$request_time,'
  '"cache":"$upstream_cache_status","referrer_origin":"$referrer_origin"}';

# Connection counts for the exporter sidecar, on the pod's loopback only:
# nothing outside the pod, the Service included, can reach it.
server {
  listen 127.0.0.1:8081;
  server_name _;
  access_log off;
  location = /stub_status {
    stub_status;
  }
  location / {
    return 404;
  }
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  server_tokens off;
  access_log /var/log/nginx/access.log landing_json;
  # Behind the gateway, a redirect must not name this pod's port or scheme.
  absolute_redirect off;
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml application/wasm;

  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # Hashed build output never changes under the same name.
  location ~ ^/(demo/)?assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    add_header X-Content-Type-Options nosniff always;
    try_files $uri =404;
  }

  # The served telemetry config, for the landing and the demo. Never cached:
  # turning it off takes effect on the next page load.
  location = /telemetry.json {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    return 200 $telemetry_json;
  }
  location = /demo/telemetry.json {
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    return 200 $telemetry_json;
  }

  # The demo is a single-page app under its own base path. Its page's own
  # <meta> policy lets it reach any https or http origin, and this header
  # narrows that to the telemetry endpoint; a browser enforces both.
  location /demo/ {
    add_header Content-Security-Policy $telemetry_connect always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    try_files $uri $uri/ /demo/index.html;
  }
  location = /demo {
    add_header Content-Security-Policy $telemetry_connect always;
    return 301 /demo/;
  }

  location / {
    # The dice are WebAssembly, the hero portraits are data: URIs, and the
    # only outside images are stargazers' GitHub avatars. The page reaches
    # only itself and, when telemetry is on, its endpoint (spec 086).
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' $telemetry_origin; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ =404;
  }

  # GitHub, read-only and cached. Each path maps to exactly one GitHub URL
  # (the query string a visitor sends is never forwarded), so nobody can spend
  # the token on anything else or fill the cache with variants.
  location /gh/ {
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host api.github.com;
    proxy_ssl_server_name on;
    proxy_ssl_name api.github.com;
    proxy_set_header Authorization $github_auth;
    proxy_set_header Accept "application/vnd.github+json";
    proxy_set_header User-Agent "thunderforge.dev";
    proxy_set_header Cookie "";

    proxy_cache github;
    proxy_cache_valid 200 10m;
    proxy_cache_valid any 1m;
    proxy_cache_use_stale error timeout updating http_403 http_429 http_500 http_502 http_503 http_504;
    proxy_cache_background_update on;
    proxy_cache_lock on;
    proxy_ignore_headers Cache-Control Expires Set-Cookie Vary X-Accel-Expires;
    proxy_hide_header Set-Cookie;
    proxy_hide_header X-RateLimit-Limit;
    proxy_hide_header X-RateLimit-Remaining;
    proxy_hide_header X-RateLimit-Reset;
    proxy_hide_header X-RateLimit-Used;
    proxy_hide_header X-RateLimit-Resource;
    proxy_hide_header X-OAuth-Scopes;
    proxy_hide_header X-Accepted-OAuth-Scopes;
    proxy_hide_header Access-Control-Allow-Origin;
    proxy_hide_header Access-Control-Expose-Headers;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Link;

    add_header Cache-Control "public, max-age=300" always;
    add_header X-Cache $upstream_cache_status always;
    add_header X-Content-Type-Options nosniff always;

    location = /gh/repo {
      set $gh "/repos/ThunderForgeVTT/ThunderForgeVTT";
      proxy_cache_key "repo";
      proxy_pass https://github_api$gh;
    }
    location = /gh/contributors {
      set $gh "/repos/ThunderForgeVTT/ThunderForgeVTT/contributors?per_page=100";
      proxy_cache_key "contributors";
      proxy_pass https://github_api$gh;
    }
    location = /gh/stargazers {
      if ($arg_page !~ "^[1-9][0-9]?$") {
        return 400;
      }
      set $gh "/repos/ThunderForgeVTT/ThunderForgeVTT/stargazers?per_page=100&page=$arg_page";
      proxy_cache_key "stargazers:$arg_page";
      proxy_pass https://github_api$gh;
    }
    return 404;
  }

  location = /healthz {
    access_log off;
    return 200 "ok\n";
  }
}
