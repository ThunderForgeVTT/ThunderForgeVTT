{
  "name": "@thunderforge/web",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "build": "pnpm run build:engine && vite build",
    "build:engine": "wasm-pack build ../../src/engine --target web --release --out-dir ./src/engine/bevy/pkg",
    "dev:engine": "wasm-pack build ../../src/engine --target web --dev --out-dir ./src/engine/bevy/pkg",
    "generate": "pnpm run build",
    "start:vite": "pnpm run build:engine && vite build --watch",
    "dev": "pnpm run dev:engine && vite"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.13",
    "sass": "1.37.5",
    "tailwindcss": "3.4.19",
    "typescript": "4.3.5",
    "vite": "^5.4.14",
    "vite-plugin-static-copy": "^1.0.6"
  },
  "dependencies": {
    "rxdb": "^17.1.0",
    "rxjs": "^7.8.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "tldraw": "^4.0.6"
  }
}
