{
  "name": "@thunderforge/web",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "build": "pnpm run generate:seo && vite build",
    "generate": "pnpm run build",
    "generate:seo": "node ./scripts/generate-seo-files.mjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --check \"{index.html,vite.config.mts,eslint.config.mjs,.prettierrc.json,src/**/*.{ts,tsx,scss},scripts/**/*.mjs}\"",
    "start:vite": "vite build --watch",
    "dev": "vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.5.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "8.5.14",
    "prettier": "^3.6.2",
    "sass": "1.99.0",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.10",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@thunderforge/engine": "workspace:^",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.14.2",
    "rxdb": "^17.2.0",
    "rxjs": "^7.8.2",
    "tldraw": "^4.5.10"
  }
}
