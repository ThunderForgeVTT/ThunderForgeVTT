{
  "name": "@thunderforge/web",
  "version": "1.0.0",
  "private": true,
  "main": "src/main.tsx",
  "scripts": {
    "build": "pnpm run generate:seo && pnpm run build:engine && vite build",
    "build:engine": "wasm-pack build ../../src/engine --target web --release --out-dir ./src/engine/bevy/pkg",
    "dev:engine": "wasm-pack build ../../src/engine --target web --dev --out-dir ./src/engine/bevy/pkg",
    "generate": "pnpm run build",
    "generate:seo": "node ./scripts/generate-seo-files.mjs",
    "lint": "eslint . --ext .ts,.tsx --max-warnings=0",
    "format": "prettier --check \"{index.html,vite.config.mts,eslint.config.mjs,.prettierrc.json,src/**/*.{ts,tsx,scss},scripts/**/*.mjs}\"",
    "start:vite": "pnpm run build:engine && vite build --watch",
    "dev": "pnpm run dev:engine && vite"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "10.5.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "8.5.14",
    "prettier": "^3.6.2",
    "sass": "1.99.0",
    "tailwindcss": "4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.0.10",
    "vite-plugin-static-copy": "^4.1.0",
    "vite-plugin-html": "^3.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "@tailwindcss/vite": "^4.2.4"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.14.2",
    "rxdb": "^17.2.0",
    "rxjs": "^7.8.2",
    "tldraw": "^4.5.10"
  }
}
