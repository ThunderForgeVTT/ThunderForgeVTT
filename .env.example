# Copy this file to .env at the repo root and fill in the values you need.
# The server loads .env from the repo root on startup (dotenvy::dotenv()
# in src/server/src/main.rs) — `pnpm dev` / `cargo run -p thunderforge` both
# run with the repo root as their working directory, so this is the only
# .env file the backend reads. (Frontend VITE_* variables are a separate,
# Vite-managed concern scoped to apps/web/ — see apps/web/.env* if you need
# to override those; they are not read from this file.)

# --- Required ---

DATABASE_URL=postgres://postgres:password@localhost/thunderforge

# --- Core server config (all optional — shown with their defaults) ---

# Session/cookie signing secret. The built-in default is a placeholder and
# is NOT safe for anything beyond local dev — set a real one (64+ random
# bytes, base64-encoded) for any shared or persistent environment.
# THUNDERFORGE_SECRET=

# Where the server stores local data (uploaded assets, manifest, etc.) when
# not using RustFS. Defaults to ./data under the current working directory.
# THUNDERFORGE_DATA_PATH=

# Set to 1/true/yes/on to mark session cookies Secure (requires HTTPS).
# Defaults to false, which is correct for local dev over plain HTTP.
# THUNDERFORGE_SECURE_COOKIES=false

# --- RustFS object storage (spec 002 — canvas image assets) ---
# Dev-only root credentials; the server mints short-lived, single-object-
# scoped STS credentials from these per write — never exposed to a client.
# See docs/adrs/20260820-039-rustfs_scoped_asset_storage.md.
# All five have built-in defaults matching the docker-compose rustfs
# service (see compose.yml) — only override if you're pointing at a
# different RustFS/S3-compatible endpoint.

# RUSTFS_ENDPOINT=http://localhost:9000
# RUSTFS_REGION=us-east-1
# RUSTFS_BUCKET=thunderforge-canvas-assets
# RUSTFS_ROOT_ACCESS_KEY=thunderforge-rustfs-root
# RUSTFS_ROOT_SECRET_KEY=thunderforge-rustfs-root-secret

# --- OAuth login providers (spec 007, ADR-041) ---
# Optional. Any provider you configure here appears as a login button
# automatically, with no admin-panel step needed — see
# specs/007-configurable-auth-providers/ and ADR-041 for the full design.
#
# Naming scheme: OAUTH_<PROVIDER>_[<INSTANCE>_]<FIELD>
#   <PROVIDER>  a built-in preset name (DISCORD, GITHUB, GOOGLE, KEYCLOAK),
#               or any other name to use the fully generic OAuth2/OIDC
#               template (see the MYSERVICE example below).
#   <INSTANCE>  optional — set to run two instances of the same provider
#               side by side (e.g. two Keycloak realms). Omit for the
#               default/only instance of that provider.
#   <FIELD>     CLIENT_ID | CLIENT_SECRET | LABEL, plus provider-specific
#               fields (ISSUER_URL for Keycloak; AUTHORIZATION_URL /
#               TOKEN_URL / USERINFO_URL / SCOPES for a generic provider).
#
# Every instance also accepts a _LABEL override to replace its default
# button text (e.g. "Log in with <LABEL>" instead of the provider's name).

# Discord (built-in preset — only client id/secret needed):
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=

# GitHub (built-in preset):
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# Google (built-in preset):
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Keycloak / self-hosted generic-OIDC (built-in preset — needs an issuer
# URL since, unlike Discord/GitHub/Google, there's no single fixed
# endpoint; auth/token/userinfo URLs are derived from it automatically):
# OAUTH_KEYCLOAK_ISSUER_URL=https://idp.example.com/realms/myrealm
# OAUTH_KEYCLOAK_CLIENT_ID=
# OAUTH_KEYCLOAK_CLIENT_SECRET=
# OAUTH_KEYCLOAK_LABEL=

# A second, named Keycloak instance alongside the default one above:
# OAUTH_KEYCLOAK_WORK_ISSUER_URL=https://work.example.com/realms/myrealm
# OAUTH_KEYCLOAK_WORK_CLIENT_ID=
# OAUTH_KEYCLOAK_WORK_CLIENT_SECRET=
# OAUTH_KEYCLOAK_WORK_LABEL=Work SSO

# Any other OAuth2/OIDC provider with no built-in preset — supply the full
# endpoint set yourself (scopes are space-separated, USERINFO_URL optional):
# OAUTH_MYSERVICE_CLIENT_ID=
# OAUTH_MYSERVICE_CLIENT_SECRET=
# OAUTH_MYSERVICE_AUTHORIZATION_URL=https://myservice.example/oauth/authorize
# OAUTH_MYSERVICE_TOKEN_URL=https://myservice.example/oauth/token
# OAUTH_MYSERVICE_USERINFO_URL=https://myservice.example/oauth/userinfo
# OAUTH_MYSERVICE_SCOPES=openid profile email

# --- Sharing a dev server publicly (make dev-tunnel) -------------------------
# Optional. Without these, `make dev-tunnel` opens a Cloudflare *quick*
# tunnel: no account needed, but the https://<random>.trycloudflare.com URL
# changes every run and the service is rate-limited often enough that "the
# tunnel is broken" is usually that.
#
# Set both for a *named* tunnel with a hostname that survives restarts, so a
# link you send someone keeps working. Create the tunnel in the Cloudflare
# Zero Trust dashboard, point its public hostname at http://localhost:5173,
# and paste its token here.
#
# TUNNEL_HOSTNAME is not optional when TUNNEL_TOKEN is set: Vite's
# server.allowedHosts must name the hostname or it answers 403 to a tunnel
# that is working perfectly.
#
# NOTE: anyone with the URL can reach the dev server, and Vite serves your
# TypeScript source over it. Treat a tunnelled dev server as public.
TUNNEL_TOKEN=
TUNNEL_HOSTNAME=
