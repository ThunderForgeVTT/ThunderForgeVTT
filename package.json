{
  "name": "thunderforge-vtt",
  "version": "1.0.0",
  "private": true,
  "repository": "git@github.com:ThunderForgeVTT/ThunderForgeVTT.git",
  "author": "mbround18 <michael.bruno1337@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "./scripts/build.mjs",
    "clean": "rimraf dist",
    "dev": "./scripts/dev.mjs",
    "format": "prettier --check \"{apps,src,scripts}/**/*.{ts,tsx,js,mjs,json,scss}\"; cargo fmt",
    "verify": "./scripts/verify.mjs",
    "marketing:metrics": "./scripts/marketing-metrics.mjs",
    "sdk:bindings": "./scripts/sdk-bindings.mjs",
    "sdk:check": "./scripts/sdk-bindings.mjs --check",
    "verify:fix": "./scripts/verify.mjs --fix",
    "test:scripts": "node --test \"scripts/e2e/__tests__/*.test.mjs\"",
    "torture": "./scripts/torture.mjs",
    "torture:5": "./scripts/torture.mjs 5",
    "torture:10": "./scripts/torture.mjs 10",
    "torture:25": "./scripts/torture.mjs 25",
    "torture:50": "./scripts/torture.mjs 50",
    "torture:100": "./scripts/torture.mjs 100",
    "playtest": "node ./scripts/e2e-parallel.mjs --suite=playtest",
    "e2e:accounts": "pnpm run e2e:accounts:integration",
    "e2e:accounts:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=accounts",
    "e2e:actors": "pnpm run e2e:actors:integration",
    "e2e:actors:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=actors",
    "e2e:book-import": "pnpm run e2e:book-import:integration",
    "e2e:book-import:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=book-import",
    "e2e:canvas": "pnpm run e2e:canvas:integration",
    "e2e:canvas:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=canvas",
    "e2e:collections": "pnpm run e2e:collections:integration",
    "e2e:collections:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=collections",
    "e2e:combat": "pnpm run e2e:combat:integration",
    "e2e:combat:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=combat",
    "e2e:companion": "pnpm run e2e:companion:integration",
    "e2e:companion:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=companion",
    "e2e:compendium": "pnpm run e2e:compendium:integration",
    "e2e:compendium:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=compendium",
    "e2e:engine-limits": "pnpm run e2e:engine-limits:integration",
    "e2e:engine-limits:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=engine-limits",
    "e2e:engine-other": "pnpm run e2e:engine-other:integration",
    "e2e:engine-other:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=engine-other",
    "e2e:feedback": "pnpm run e2e:feedback:integration",
    "e2e:feedback:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=feedback",
    "e2e:game-systems": "pnpm run e2e:game-systems:integration",
    "e2e:game-systems:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=game-systems",
    "e2e:genie": "pnpm run e2e:genie:integration",
    "e2e:genie:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=genie",
    "e2e:hero-builder": "pnpm run e2e:hero-builder:standalone && pnpm run e2e:hero-builder:integration",
    "e2e:hero-builder:standalone": "pnpm -F @thunderforge/hero-builder-app test:e2e",
    "e2e:hero-builder:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=hero-builder",
    "e2e:instance": "pnpm run e2e:instance:integration",
    "e2e:instance:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=instance",
    "e2e:interactive": "pnpm run e2e:interactive:integration",
    "e2e:interactive:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=interactive",
    "e2e:lighting": "pnpm run e2e:lighting:integration",
    "e2e:lighting:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=lighting",
    "e2e:lore": "pnpm run e2e:lore:integration",
    "e2e:lore:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=lore",
    "e2e:moderation": "pnpm run e2e:moderation:integration",
    "e2e:moderation:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=moderation",
    "e2e:play-pause": "pnpm run e2e:play-pause:integration",
    "e2e:play-pause:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=play-pause",
    "e2e:scenes": "pnpm run e2e:scenes:integration",
    "e2e:scenes:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=scenes",
    "e2e:status": "pnpm run e2e:status:integration",
    "e2e:status:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=status",
    "e2e:tokens": "pnpm run e2e:tokens:integration",
    "e2e:tokens:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=tokens",
    "e2e:torture": "pnpm run e2e:torture:integration",
    "e2e:torture:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=torture",
    "e2e:world-cache": "pnpm run e2e:world-cache:integration",
    "e2e:world-cache:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=world-cache",
    "e2e:world-cache-core": "pnpm run e2e:world-cache-core:integration",
    "e2e:world-cache-core:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=world-cache-core",
    "e2e:worlds": "pnpm run e2e:worlds:integration",
    "e2e:worlds:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --slice=worlds",
    "e2e:slices": "node ./scripts/e2e-slice.mjs list",
    "e2e:which": "node ./scripts/e2e-slice.mjs which",
    "journeys": "node ./scripts/journeys.mjs",
    "prepare": "node ./scripts/install-hooks.mjs",
    "hooks:install": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "rimraf": "6.1.3"
  }
}
