{
  "name": "thunderforge-vtt",
  "version": "1.0.0",
  "private": true,
  "repository": "git@github.com:ThunderForgeVTT/ThunderForgeVTT.git",
  "author": "mbround18 <michael.bruno1337@gmail.com>",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "./scripts/build.mjs",
    "clean": "rimraf dist",
    "dev": "./scripts/dev.mjs",
    "format": "prettier --check \"{apps,src,scripts}/**/*.{ts,tsx,js,mjs,json,scss}\"; cargo fmt",
    "verify": "./scripts/verify.mjs",
    "marketing:metrics": "./scripts/marketing-metrics.mjs",
    "sdk:bindings": "./scripts/sdk-bindings.mjs",
    "sdk:check": "./scripts/sdk-bindings.mjs --check",
    "verify:fix": "./scripts/verify.mjs --fix",
    "test:scripts": "node --test \"scripts/e2e/__tests__/*.test.mjs\"",
    "torture": "./scripts/torture.mjs",
    "torture:5": "./scripts/torture.mjs 5",
    "torture:10": "./scripts/torture.mjs 10",
    "torture:25": "./scripts/torture.mjs 25",
    "torture:50": "./scripts/torture.mjs 50",
    "torture:100": "./scripts/torture.mjs 100",
    "playtest": "node ./scripts/e2e-parallel.mjs --suite=playtest",
    "e2e:hero-builder": "pnpm run e2e:hero-builder:standalone && pnpm run e2e:hero-builder:integration",
    "e2e:hero-builder:standalone": "pnpm -F @thunderforge/hero-builder-app test:e2e",
    "e2e:hero-builder:integration": "node ./scripts/e2e-parallel.mjs --shards=1 --only=hero-builder-,actor-art",
    "journeys": "node ./scripts/journeys.mjs",
    "prepare": "node ./scripts/install-hooks.mjs",
    "hooks:install": "node ./scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "rimraf": "6.1.3"
  }
}
