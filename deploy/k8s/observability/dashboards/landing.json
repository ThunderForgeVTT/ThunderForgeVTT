{
  "title": "ThunderForge: Landing",
  "description": "thunderforge.dev: nginx's health and access log, and what visitors do on the page (spec 086 US4).",
  "tags": ["thunderforge", "spec-086"],
  "timezone": "browser",
  "schemaVersion": 39,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "tempo",
        "label": "Tempo",
        "type": "datasource",
        "query": "tempo",
        "current": {},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "nginx",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "nginx up",
      "description": "nginx_up from the exporter sidecar, which reads stub_status on the pod's loopback (127.0.0.1:8081). 0 means the exporter cannot reach nginx; no value means the sidecar is not deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "down",
                  "color": "red"
                },
                "1": {
                  "text": "up",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "min(nginx_up{namespace=\"thunderforge-dev\"})",
          "legendFormat": "up",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "id": 2,
      "gridPos": {
        "h": 6,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Requests per second",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(nginx_http_requests_total{namespace=\"thunderforge-dev\"}[$__rate_interval]))",
          "legendFormat": "requests/s"
        }
      ],
      "description": "Every request nginx served, /healthz and probes included, from stub_status.",
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum by (__name__) ({__name__=~\"nginx_connections_(active|reading|writing|waiting)\", namespace=\"thunderforge-dev\"})",
          "legendFormat": "{{__name__}}"
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 6,
        "w": 10,
        "x": 14,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Access log",
      "collapsed": false,
      "panels": [],
      "id": 5,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (status) (count_over_time({namespace=\"thunderforge-dev\", container=\"nginx\"} | json | __error__=\"\" [$__interval]))",
          "legendFormat": "{{status}}"
        }
      ],
      "description": "From the landing's JSON access log (landing_json). /healthz is not logged, and the log holds no address, query or user agent.",
      "id": 6,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Bytes sent",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(sum_over_time({namespace=\"thunderforge-dev\", container=\"nginx\"} | json | __error__=\"\" | unwrap bytes [$__interval]))",
          "legendFormat": "bytes"
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      }
    },
    {
      "type": "table",
      "title": "Requests by path",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["sum"]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "topk(25, sum by (path, status) (count_over_time({namespace=\"thunderforge-dev\", container=\"nginx\"} | json | __error__=\"\" [$__range])))",
          "legendFormat": "{{path}} {{status}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "description": "The 25 busiest paths and their statuses over the range. The path is logged without its query.",
      "id": 8,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 17
      }
    },
    {
      "type": "timeseries",
      "title": "/gh/ cache status",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (cache) (count_over_time({namespace=\"thunderforge-dev\", container=\"nginx\"} | json | __error__=\"\" | path=~\"/gh/.*\" [$__interval]))",
          "legendFormat": "{{cache}}"
        }
      ],
      "description": "The GitHub proxy's $upstream_cache_status: HIT is served from nginx's cache, MISS and EXPIRED went to GitHub.",
      "id": 9,
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 17
      }
    },
    {
      "type": "row",
      "title": "Visitors",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      }
    },
    {
      "type": "timeseries",
      "title": "Page views",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"page_view\" [$__interval]))",
          "legendFormat": "page views"
        }
      ],
      "description": "page_view from the landing's own telemetry, one per load.",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "timeseries",
      "title": "CTA clicks",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (cta, placement) (count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"cta_clicked\" [$__interval]))",
          "legendFormat": "{{cta}} ({{placement}})"
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      }
    },
    {
      "type": "table",
      "title": "Referrers",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["sum"]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (referrer_origin) (count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"page_view\" [$__range]))",
          "legendFormat": "{{referrer_origin}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "description": "The referring page reduced to its origin; empty is a direct visit.",
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 36
      }
    },
    {
      "type": "table",
      "title": "UTM sources",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "reduce",
          "options": {
            "reducers": ["sum"]
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (utm_source, utm_medium, utm_campaign) (count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"page_view\" [$__range]))",
          "legendFormat": "{{utm_source}} {{utm_medium}} {{utm_campaign}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "description": "utm_source, utm_medium and utm_campaign from the first page view, each reduced to letters, digits, dot, dash and underscore.",
      "id": 14,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 36
      }
    },
    {
      "type": "bargauge",
      "title": "Scroll depth: sessions reaching each section",
      "description": "scroll_depth sends the deepest section seen when the page is hidden, and again only if the visitor went deeper. Each panel row is the number of sessions whose deepest report reached that section.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (section) (count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"scroll_depth\" [$__range]))",
          "legendFormat": "{{section}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 36
      }
    },
    {
      "type": "bargauge",
      "title": "Web vitals at p75",
      "description": "web_vital from sampled sessions. The landing is one page, so this is the page's p75: LCP, INP, FCP and TTFB in milliseconds, CLS unitless.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "quantile_over_time(0.75, {service_name=\"thunderforge-landing\"} | event_name=\"web_vital\" | unwrap value [$__range]) by (metric)",
          "legendFormat": "{{metric}}",
          "instant": true,
          "queryType": "instant"
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 45
      }
    },
    {
      "type": "timeseries",
      "title": "Web vital ratings",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": ["sum"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (metric, rating) (count_over_time({service_name=\"thunderforge-landing\"} | event_name=\"web_vital\" [$__interval]))",
          "legendFormat": "{{metric}} {{rating}}"
        }
      ],
      "description": "good, needs-improvement and poor, as web-vitals rates each measure.",
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 45
      }
    }
  ]
}
