          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "sum(rate(thunderforge_telemetry_gateway_dropped_total[$__rate_interval])) / (sum(rate(thunderforge_telemetry_gateway_dropped_total[$__rate_interval])) + sum(rate(thunderforge_telemetry_gateway_accepted_total[$__rate_interval])))",
          "legendFormat": "dropped"
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
