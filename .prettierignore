# ts-rs writes these (`pnpm sdk:bindings`), and `sdk:check` compares them
# byte-for-byte with a fresh export. Were prettier to own them too, the two
# would fight and the check would report drift that no source change caused.
# The generator is the authority on their formatting; `pnpm sdk:check` is what
# guards them.
apps/web/src/engine/sdk/*.ts
!apps/web/src/engine/sdk/commands.ts
