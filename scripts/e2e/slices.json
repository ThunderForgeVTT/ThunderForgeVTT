{
  "$comment": "One owner per spec; see docs/CONTRIBUTING.md 'Proving a change'. Checked by scripts/check-e2e-slices.mjs.",
  "crossCutting": [
    {
      "glob": "src/app/schema.graphql",
      "why": "every client speaks this schema"
    },
    {
      "glob": "apps/web/src/engine/sdk/**",
      "why": "the generated SDK bindings every engine command and display is typed against"
    },
    {
      "glob": "src/server/src/auth/**",
      "why": "every spec signs in through it"
    },
    {
      "glob": "src/server/src/auth_middleware.rs",
      "why": "every signed-in request passes through it"
    },
    {
      "glob": "crates/thunderforge-axum-auth-core/**",
      "why": "password hashing, sessions and CSRF, which every sign-in uses"
    },
    {
      "glob": "crates/thunderforge-authz/**",
      "why": "world membership and scene visibility, which the auth checks every world page passes"
    },
    {
      "glob": "src/server/seeds/{demo_accounts,e2e_demo}.sql",
      "why": "the template database and demo sign-in every run starts from"
    },
    {
      "glob": "src/server/src/schema.rs",
      "why": "the database schema every query is written against"
    },
    {
      "glob": "src/server/migrations/**",
      "why": "schema history every slice reads"
    },
    {
      "glob": "src/server/src/{lib,graphql,models,db_types,state,pubsub,world_events}.rs",
      "why": "server wiring every request, model and world event goes through"
    },
    {
      "glob": "src/server/src/graphql/{types,input_types,helpers,subscriptions}.rs",
      "why": "GraphQL types and the subscription every client listens on"
    },
    {
      "glob": "src/server/Cargo.toml",
      "why": "the server's features and dependencies, which every stack is built with"
    },
    {
      "glob": "src/app/Cargo.toml",
      "why": "the server binary every stack runs"
    },
    {
      "glob": "src/app/src/{main,schema_roots}.rs",
      "why": "the server binary every stack runs, and the roots of its schema"
    },
    {
      "glob": "apps/web/src/api/graphqlClient.ts",
      "why": "every query, mutation and subscription goes through it"
    },
    {
      "glob": "apps/web/src/engine/world/{store,types}.ts",
      "why": "the world store, the one sync path between server, engine and UI"
    },
    {
      "glob": "apps/web/src/engine/world/sync/{index,subscriptionClient}.ts",
      "why": "the world store's subscription wiring, which every live page depends on"
    },
    {
      "glob": "apps/web/src/{main,App}.tsx",
      "why": "every page mounts through the app shell"
    },
    {
      "glob": "apps/web/src/routes/**",
      "why": "every page is reached through the router"
    },
    {
      "glob": "apps/web/src/layouts/{BaseLayout.tsx,main-layout/**}",
      "why": "the layout nearly every page renders inside"
    },
    {
      "glob": "apps/web/{index.html,package.json,tsconfig.json,vite.config.mts,tailwind.config.js,postcss.config.js}",
      "why": "how the web app every spec loads is built"
    },
    {
      "glob": "apps/web/src/components/ui/**",
      "why": "shared UI primitives on every page"
    },
    {
      "glob": "apps/web/src/styles/**",
      "why": "global styles every page renders with"
    },
    {
      "glob": "apps/web/e2e/fixtures/**",
      "why": "shared e2e fixtures every spec builds on"
    },
    {
      "glob": "apps/web/e2e/harness/**",
      "why": "shared e2e harness mounts"
    },
    {
      "glob": "apps/web/playwright.config.ts",
      "why": "how every spec runs"
    },
    {
      "glob": "scripts/e2e-parallel.mjs",
      "why": "the e2e runner itself"
    },
    {
      "glob": "scripts/e2e/{deps,load,mailpit,report,run-lock,select,slice-durations,slices,specs}.mjs",
      "why": "the e2e runner's modules: which specs run, on which stack, and how results are read"
    },
    {
      "glob": "scripts/shared.mjs",
      "why": "builds the engine and PDF wasm and starts the processes every run uses"
    },
    {
      "glob": "pnpm-lock.yaml",
      "why": "every JavaScript dependency"
    },
    {
      "glob": "Cargo.lock",
      "why": "every Rust dependency"
    }
  ],
